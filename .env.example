# =============================================================================
# Data paths
# =============================================================================
DATA_DIR=./data
PENGUINS_CSV_URL=https://raw.githubusercontent.com/dataprofessor/code/master/streamlit/part3/penguins_cleaned.csv

# =============================================================================
# S3/LocalStack
# =============================================================================
S3_BUCKET=wildlife
S3_PARQUET_KEY=raw/penguins.parquet

# AWS CLI config (project-local credentials for LocalStack)
AWS_CONFIG_FILE=.aws/config
AWS_SHARED_CREDENTIALS_FILE=.aws/credentials
AWS_PROFILE=localstack
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LocalStack endpoints
AWS_ENDPOINT_URL=http://localhost:4566
LOCALSTACK_ENDPOINT=localstack:4566

# =============================================================================
# Postgres (standard PG* variables)
# =============================================================================
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGDATABASE=postgres
PG_CONTAINER=pg_lake

# =============================================================================
# psql options
# =============================================================================
# -e: echo queries sent to server (helpful for demos)
# -a: echo all input including comments
PSQL_OPTS=-e
